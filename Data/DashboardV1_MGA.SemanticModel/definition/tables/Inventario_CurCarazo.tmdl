		annotation SummarizationSetBy = Automatic

	column 'Categoria Obsolescencia' =
			
			IF(
			    Inventario_CurCarazo[Dispositivo] IN { "Desktop", "Laptop" },
			    SWITCH(
			        TRUE(),
			        Inventario_CurCarazo[Gen_Procesador] IN {
			            "Gen_1","Gen_2","Gen_3","Gen_4"
			        }, "Obsoleto",
			        Inventario_CurCarazo[Gen_Procesador] IN {
			            "Gen_5","Gen_6","Gen_7","Gen_8","Gen_9"
			        }, "Vigilancia",
			        Inventario_CurCarazo[Gen_Procesador] IN {
			            "Gen_10","Gen_11","Gen_12",
			            "Gen_13","Gen_14"
			        }, "Vigente",
			        Inventario_CurCarazo[Gen_Procesador] = "Pendiente", "Pendiente",
			        "Pendiente"
			    ),
			    "N/A"
			)
		lineageTag: f0347352-bd52-4822-893e-bd0dbf778c1e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Categoria RAM' =
			
			SWITCH(
			    TRUE(),
			    Inventario_CurCarazo[RAM] = "Pendiente",  "Pendiente",
			    Inventario_CurCarazo[RAM] = "4 GB RAM",   "4 GB RAM",
			    Inventario_CurCarazo[RAM] = "8 GB RAM",   "8 GB RAM",
			    Inventario_CurCarazo[RAM] = "12 GB RAM",  "12 GB RAM",
			    Inventario_CurCarazo[RAM] = "16 GB RAM",  "16 GB RAM",
			    Inventario_CurCarazo[RAM] = "24 GB RAM",  "24 GB RAM",
			    Inventario_CurCarazo[RAM] = "32 GB RAM",  "32 GB RAM",
			    "Pendiente"
			)
		lineageTag: 7643c974-71b8-482f-aedd-0234a51799b3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Estado Datos' =
			
			IF(
			    Inventario_CurCarazo[email] = "Pendiente"
			        || ISBLANK(Inventario_CurCarazo[Nombre del equipo])
			        || ISBLANK(Inventario_CurCarazo[Estado])
			        || Inventario_CurCarazo[Ubicación] = "Pendiente"
			        || ISBLANK(Inventario_CurCarazo[Ubicación])
			        || ISBLANK(Inventario_CurCarazo[Aréa])
			        || Inventario_CurCarazo[IP] = "Pendiente"
			        || ISBLANK(Inventario_CurCarazo[IP])
			        || Inventario_CurCarazo[MAC] = "Pendiente"
			        || ISBLANK(Inventario_CurCarazo[MAC])
			        || Inventario_CurCarazo[Dispositivo] = "Pendiente"
			        || ISBLANK(Inventario_CurCarazo[Dispositivo])
			        || Inventario_CurCarazo[Marca] = "Pendiente"
			        || ISBLANK(Inventario_CurCarazo[Marca])
			        || Inventario_CurCarazo[Procesador] = "Pendiente"
			        || ISBLANK(Inventario_CurCarazo[Procesador])
			        || Inventario_CurCarazo[Gen_Procesador] = "Pendiente"
			        || ISBLANK(Inventario_CurCarazo[Gen_Procesador])
			        || Inventario_CurCarazo[RAM] = "Pendiente"
			        || ISBLANK(Inventario_CurCarazo[RAM])
			        || Inventario_CurCarazo[Sistema Operativo] = "Pendiente"
			        || ISBLANK(Inventario_CurCarazo[Sistema Operativo])
			        || Inventario_CurCarazo[Office] = "Pendiente"
			        || ISBLANK(Inventario_CurCarazo[Office])
			        || Inventario_CurCarazo[Modelo] = "Pendiente"
			        || ISBLANK(Inventario_CurCarazo[Modelo])
			        || Inventario_CurCarazo[Serie] = "Pendiente"
			        || ISBLANK(Inventario_CurCarazo[Serie]),
			    "Pendiente",
			    "Completo"
			)
		lineageTag: b5627abd-90f0-42a2-8082-e1b281cec96e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

