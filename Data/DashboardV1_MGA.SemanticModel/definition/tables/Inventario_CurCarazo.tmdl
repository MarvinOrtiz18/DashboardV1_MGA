table Inventario_CurCarazo
	lineageTag: bc1dc90c-aca8-4365-abe8-a8489ea52113

	measure 'Total Equipos' = COUNTROWS( Inventario_CurCarazo )
		formatString: 0
		lineageTag: fedb701f-81a7-43fa-9d1e-7c38856d1c62

	measure 'Equipos Asignados' =
			
			COUNTROWS(
			    FILTER(
			        Inventario_CurCarazo,
			        Inventario_CurCarazo[email] <> "Pendiente"
			            && NOT( ISBLANK( Inventario_CurCarazo[email] ) )
			    )
			)
		formatString: 0
		lineageTag: 9ef79f4d-d4eb-4e43-987e-53971cb16de6

	measure 'Equipos Sin Asignar' =
			
			[Total Equipos] - [Equipos Asignados]
		formatString: 0
		lineageTag: 48bce347-2bd3-44ab-8a27-3432065053fe

	measure 'Pct Asignacion' =
			
			DIVIDE(
			    [Equipos Asignados],
			    [Total Equipos],
			    0
			)
		lineageTag: de3149ed-d77d-48c1-9cab-d29b1e284a6c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Perifericos' =
			
			COUNTROWS(
			    FILTER(
			        Inventario_CurCarazo,
			        Inventario_CurCarazo[Dispositivo] IN { "Desktop", "Laptop", "Impresora", "UPS", "Telefono", "Televisor", "Proyector", "Gatewar", "Switch", "Ap", "Monitor"}
			    )
			)
		formatString: 0
		lineageTag: ead8ee17-8831-42b8-85cf-b5e2de6abfee

	measure 'Equipos por Area' = CALCULATE( [Total Equipos] )
		formatString: 0
		lineageTag: 9530cf4a-ef38-454c-800f-ce691aff18ed

	measure 'Pct Area vs Total' =
			
			DIVIDE(
			    [Equipos por Area],
			    CALCULATE(
			        [Total Equipos],
			        ALL( Inventario_CurCarazo[Aréa] )
			    ),
			    0
			)
		lineageTag: 6afebacf-a760-494a-b1f8-5483af6e6518

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sin Asignar por Area' = CALCULATE( [Equipos Sin Asignar] )
		formatString: 0
		lineageTag: 26c0c2b5-1591-428a-a73a-df03054f106b

	measure 'Promedio por Area' =
			
			AVERAGEX(
			    VALUES( Inventario_CurCarazo[Aréa] ),
			    CALCULATE( [Total Equipos] )
			)
		lineageTag: 2d653ae2-b05c-4943-8cd7-586b9ab7e7f9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Area Top' =
			
			CALCULATE(
			    SELECTEDVALUE( Inventario_CurCarazo[Aréa] ),
			    TOPN(
			        1,
			        SUMMARIZE(
			            Inventario_CurCarazo,
			            Inventario_CurCarazo[Aréa],
			            "n", COUNTROWS( Inventario_CurCarazo )
			        ),
			        [n], DESC
			    )
			)
		lineageTag: 51fce429-327a-4a46-993e-da9cb0f0c770

	measure 'RAM Promedio GB' =
			
			AVERAGEX(
			    FILTER(
			        Inventario_CurCarazo,
			        Inventario_CurCarazo[RAM] <> "Pendiente"
			    ),
			    VALUE(
			        LEFT(
			            Inventario_CurCarazo[RAM],
			            FIND(" ", Inventario_CurCarazo[RAM]) - 1
			        )
			    )
			)
		formatString: 0
		lineageTag: 14cfc4cb-4074-48d5-aa2d-6f22dda0a210

	measure 'RAM Critica' =
			
			COUNTROWS(
			    FILTER(
			        Inventario_CurCarazo,
			        Inventario_CurCarazo[Categoria RAM] = "Crítica (≤ 4GB)"
			    )
			)
		formatString: 0
		lineageTag: fd5ea629-91dd-41b4-bb6a-1e2956e7e668

	measure 'SW Windows11' =
			
			COUNTROWS(
			    FILTER(
			        Inventario_CurCarazo,
			        Inventario_CurCarazo[Sistema Operativo] = "Windows 11"
			    )
			)
		formatString: 0
		lineageTag: cf153598-f11f-4b84-9b10-ab0f1a42f824

	measure 'SW Windows10' =
			
			COUNTROWS(
			    FILTER(
			        Inventario_CurCarazo,
			        Inventario_CurCarazo[Sistema Operativo] = "Windows 10"
			    )
			)
		formatString: 0
		lineageTag: 37578055-4656-4d31-9566-d6815b50c3de

	measure 'SW Office365' =
			
			COUNTROWS(
			    FILTER(
			        Inventario_CurCarazo,
