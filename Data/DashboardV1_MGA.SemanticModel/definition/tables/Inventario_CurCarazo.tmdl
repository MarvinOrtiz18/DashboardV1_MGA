	column Probando
		dataType: string
		lineageTag: 9c398587-95e9-4c3b-add6-34cb31c3f01f
		summarizeBy: none
		sourceColumn: Probando

		annotation SummarizationSetBy = Automatic

	column 'Inventario Duplicado' =
			
			VAR ValorInventario = Inventario_CurCarazo[Inventario]
			VAR ValorSerie = Inventario_CurCarazo[Serie]
			
			VAR ConteoInventario =
			    CALCULATE(
			        COUNTROWS( Inventario_CurCarazo ),
			        ALL( Inventario_CurCarazo ),
			        Inventario_CurCarazo[Inventario] = ValorInventario
			    )
			
			VAR ConteoSerie =
			    CALCULATE(
			        COUNTROWS( Inventario_CurCarazo ),
			        ALL( Inventario_CurCarazo ),
			        Inventario_CurCarazo[Serie] = ValorSerie
			    )
			
			VAR InventarioDuplicado =
			    ConteoInventario > 1
			        && NOT( ISBLANK( ValorInventario ) )
			        && UPPER( TRIM( ValorInventario ) ) <> "PENDIENTE"
			        && UPPER( TRIM( ValorInventario ) ) <> "S/E"
			
			VAR SerieDuplicada =
			    ConteoSerie > 1
			        && NOT( ISBLANK( ValorSerie ) )
			        && UPPER( TRIM( ValorSerie ) ) <> "PENDIENTE"
			        && UPPER( TRIM( ValorSerie ) ) <> "S/E"
			        && UPPER( TRIM( ValorSerie ) ) <> ""
			
			RETURN
			SWITCH(
			    TRUE(),
			    InventarioDuplicado && SerieDuplicada,
			        "Inventario y Serie duplicados (" & ConteoInventario & " veces)",
			    InventarioDuplicado,
			        "Inventario duplicado (" & ConteoInventario & " veces)",
			    SerieDuplicada,
			        "Serie duplicada (" & ConteoSerie & " veces)",
			    "OK"
			)
		lineageTag: bdf9e043-4ac4-4ed7-b481-ed8cbf649de0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Conteo Inventario' =
			
			VAR ValorActual = Inventario_CurCarazo[Inventario]
			RETURN
			IF(
			    ISBLANK( ValorActual )
			        || UPPER( TRIM( ValorActual ) ) = "PENDIENTE"
			        || UPPER( TRIM( ValorActual ) ) = "S/E",
			    BLANK(),
			    CALCULATE(
			        COUNTROWS( Inventario_CurCarazo ),
			        ALL( Inventario_CurCarazo ),
			        Inventario_CurCarazo[Inventario] = ValorActual
			    )
			)
		formatString: 0
		lineageTag: db379da5-dec2-41f8-9274-57d79260d20a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Modelo
		dataType: string
		lineageTag: 8396e434-78f9-4514-bf46-c90d3d355096
		summarizeBy: none
