			)
		formatString: 0
		lineageTag: 2977f84e-d15f-4a92-8d32-b1bef20535d9

	measure 'Top Modelo por Dispositivo' =
			
			CALCULATE(
			    SELECTEDVALUE( Inventario_CurCarazo[Modelo] ),
			    TOPN(
			        1,
			        SUMMARIZE(
			            FILTER(
			                Inventario_CurCarazo,
			                Inventario_CurCarazo[Dispositivo] = SELECTEDVALUE( Inventario_CurCarazo[Dispositivo] )
			                    && UPPER( TRIM( Inventario_CurCarazo[Modelo] ) ) <> "PENDIENTE"
			            ),
			            Inventario_CurCarazo[Modelo],
			            "n", COUNTROWS( Inventario_CurCarazo )
			        ),
			        [n], DESC
			    )
			)
		lineageTag: 29ee8123-fca0-4093-b8c4-b3c5277f6ceb

	measure 'Sidebar HTML' =
			
			"<div style='
			    background:#153455;
			    width:100%;
			    height:100%;
			    font-family:Trebuchet MS, sans-serif;
			    box-sizing:border-box;
			    display:flex;
			    flex-direction:column;
			    overflow:hidden;
			    position:relative;
			'>
			    <!-- DETALLE DECORATIVO ESQUINA SUPERIOR DERECHA -->
			    <div style='
			        position:absolute;
			        top:0;
			        right:0;
			        width:60px;
			        height:60px;
			        background:linear-gradient(225deg, #2C5697 0%, transparent 70%);
			        border-radius:0 0 0 60px;
			    '></div>
			    <div style='
			        position:absolute;
			        top:0;
			        right:0;
			        width:35px;
			        height:35px;
			        background:linear-gradient(225deg, #F5BD46 0%, transparent 70%);
			        border-radius:0 0 0 35px;
			        opacity:0.7;
			    '></div>
			
			    <!-- LOGO -->
			    <div style='
			        padding:clamp(14px,3%,24px) clamp(12px,15%,28px);
			        flex-shrink:0;
			    '>
			        <div style='
			            font-size:clamp(13px,2.5vw,18px);
			            font-weight:700;
			            color:#FFFFFF;
			            white-space:nowrap;
			        '>CurCarazo</div>
			        <div style='
			            font-size:clamp(7px,1.2vw,9px);
			            color:#9DB3CC;
			            letter-spacing:2px;
			            margin-top:2px;
			        '>IT ASSETS</div>
			    </div>
			
			    <!-- SEPARADOR -->
			    <div style='height:1px;background:#2C5697;flex-shrink:0;'></div>
			
			    <!-- ETIQUETA NAVEGACIÓN -->
			    <div style='
			        padding:clamp(10px,2%,16px) clamp(12px,15%,28px) clamp(6px,1%,10px);
			        flex-shrink:0;
			    '>
			        <span style='
			            font-size:clamp(7px,1vw,9px);
			            font-weight:700;
			            color:#9DB3CC;
			            letter-spacing:3px;
			        '>NAVEGACIÓN</span>
