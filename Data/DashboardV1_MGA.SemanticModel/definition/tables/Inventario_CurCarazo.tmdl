	measure 'Label Pct EQUIPOS' =
			
			VAR Total = [Total Equipos]
			VAR Pct = FORMAT( DIVIDE( Total, CALCULATE( [Total Equipos], ALL( Inventario_CurCarazo[Dispositivo] ) ), 0 ) * 100, "0.0" )
			RETURN
			Total & "  (" & Pct & "%)"
		lineageTag: bb3f1e4d-e07c-40fa-943c-aa8c1bfadb66

	measure 'Equipos Sin MAC' =
			
			COUNTROWS(
			    FILTER(
			        Inventario_CurCarazo,
			        UPPER( TRIM( Inventario_CurCarazo[MAC] ) ) = "PENDIENTE"
			            || Inventario_CurCarazo[MAC] = "Medios desconectados"
			            || ISBLANK( Inventario_CurCarazo[MAC] )
			    )
			)
		formatString: 0
		lineageTag: 57f9a124-47ff-4cfe-8f6e-757aebd9726a

