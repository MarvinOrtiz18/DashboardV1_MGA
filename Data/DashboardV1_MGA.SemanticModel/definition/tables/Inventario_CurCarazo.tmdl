			    [HW Obsoletos],
			    COUNTROWS(
			        FILTER(
			            Inventario_CurCarazo,
			            Inventario_CurCarazo[Categoria Obsolescencia] <> "Pendiente"
			        )
			    ),
			    0
			)
		lineageTag: beda82c8-5f1f-46f2-a382-42fcd590b499

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Equipos Pendientes Info' =
			
			COUNTROWS(
			    FILTER(
			        Inventario_CurCarazo,
			        Inventario_CurCarazo[email]    = "Pendiente" || ISBLANK(Inventario_CurCarazo[email])
			            || Inventario_CurCarazo[Nombre del equipo] = "Pendiente" || ISBLANK(Inventario_CurCarazo[Nombre del equipo])
			            || Inventario_CurCarazo[Estado]            = "Pendiente" || ISBLANK(Inventario_CurCarazo[Estado])
			            || Inventario_CurCarazo[Ubicación]         = "Pendiente" || ISBLANK(Inventario_CurCarazo[Ubicación])
			            || Inventario_CurCarazo[Aréa]              = "Pendiente" || ISBLANK(Inventario_CurCarazo[Aréa])
			            || Inventario_CurCarazo[IP]                = "Pendiente" || ISBLANK(Inventario_CurCarazo[IP])
			            || Inventario_CurCarazo[MAC]               = "Pendiente" || ISBLANK(Inventario_CurCarazo[MAC])
			            || Inventario_CurCarazo[Dispositivo]       = "Pendiente" || ISBLANK(Inventario_CurCarazo[Dispositivo])
			            || Inventario_CurCarazo[Marca]             = "Pendiente" || ISBLANK(Inventario_CurCarazo[Marca])
			            || Inventario_CurCarazo[Procesador]        = "Pendiente" || ISBLANK(Inventario_CurCarazo[Procesador])
			            || Inventario_CurCarazo[Gen_Procesador]    = "Pendiente" || ISBLANK(Inventario_CurCarazo[Gen_Procesador])
			            || Inventario_CurCarazo[RAM]               = "Pendiente" || ISBLANK(Inventario_CurCarazo[RAM])
			            || Inventario_CurCarazo[Sistema Operativo] = "Pendiente" || ISBLANK(Inventario_CurCarazo[Sistema Operativo])
			            || Inventario_CurCarazo[Edición del S.O]   = "Pendiente" || ISBLANK(Inventario_CurCarazo[Edición del S.O])
			            || Inventario_CurCarazo[Office]            = "Pendiente" || ISBLANK(Inventario_CurCarazo[Office])
			            || Inventario_CurCarazo[Inventario]        = "Pendiente" || ISBLANK(Inventario_CurCarazo[Inventario])
			    )
			)
		formatString: 0
		lineageTag: bb3367a1-4c86-44d0-9856-f8ebd2c698d6

	measure 'Pct Datos Completos' =
			
			DIVIDE(
			    COUNTROWS(
			        FILTER(
			            Inventario_CurCarazo,
			            Inventario_CurCarazo[email]              <> "Pendiente" && NOT(ISBLANK(Inventario_CurCarazo[email]))
			                && Inventario_CurCarazo[Nombre del equipo] <> "Pendiente" && NOT(ISBLANK(Inventario_CurCarazo[Nombre del equipo]))
			                && Inventario_CurCarazo[Estado]            <> "Pendiente" && NOT(ISBLANK(Inventario_CurCarazo[Estado]))
			                && Inventario_CurCarazo[Ubicación]         <> "Pendiente" && NOT(ISBLANK(Inventario_CurCarazo[Ubicación]))
			                && Inventario_CurCarazo[Aréa]              <> "Pendiente" && NOT(ISBLANK(Inventario_CurCarazo[Aréa]))
			                && Inventario_CurCarazo[IP]                <> "Pendiente" && NOT(ISBLANK(Inventario_CurCarazo[IP]))
			                && Inventario_CurCarazo[MAC]               <> "Pendiente" && NOT(ISBLANK(Inventario_CurCarazo[MAC]))
			                && Inventario_CurCarazo[Dispositivo]       <> "Pendiente" && NOT(ISBLANK(Inventario_CurCarazo[Dispositivo]))
			                && Inventario_CurCarazo[Marca]             <> "Pendiente" && NOT(ISBLANK(Inventario_CurCarazo[Marca]))
			                && Inventario_CurCarazo[Procesador]        <> "Pendiente" && NOT(ISBLANK(Inventario_CurCarazo[Procesador]))
			                && Inventario_CurCarazo[Gen_Procesador]    <> "Pendiente" && NOT(ISBLANK(Inventario_CurCarazo[Gen_Procesador]))
			                && Inventario_CurCarazo[RAM]               <> "Pendiente" && NOT(ISBLANK(Inventario_CurCarazo[RAM]))
			                && Inventario_CurCarazo[Sistema Operativo] <> "Pendiente" && NOT(ISBLANK(Inventario_CurCarazo[Sistema Operativo]))
			                && Inventario_CurCarazo[Edición del S.O]   <> "Pendiente" && NOT(ISBLANK(Inventario_CurCarazo[Edición del S.O]))
			                && Inventario_CurCarazo[Office]            <> "Pendiente" && NOT(ISBLANK(Inventario_CurCarazo[Office]))
			                && Inventario_CurCarazo[Inventario]        <> "Pendiente" && NOT(ISBLANK(Inventario_CurCarazo[Inventario]))
			        )
			    ),
			    [Total Equipos],
			    0
			)
		lineageTag: 6988d5a0-c300-47be-9574-b65acb2a41c1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Datos Completos' =
			
			[Total Equipos] - [Equipos Pendientes Info]
		formatString: 0
		lineageTag: 73beaa55-73bd-41fa-9e83-f2af668fce80

	measure 'Pendientes por Area' =
			
			COUNTROWS(
			    FILTER(
			        Inventario_CurCarazo,
			        Inventario_CurCarazo[Categoria Obsolescencia] = "Pendiente"
			            || Inventario_CurCarazo[Categoria RAM] = "Pendiente"
			    )
			)
		formatString: 0
		lineageTag: 64df5580-ef82-450a-98c5-074046b0b557

	measure 'Tooltip HTML Obsolescencia' =
			
			VAR Cat = SELECTEDVALUE( Inventario_CurCarazo[Categoria Obsolescencia] )
			VAR TotalCat = [Total Equipos]
			VAR PctCat = FORMAT( DIVIDE( TotalCat, CALCULATE( [Total Equipos], ALL( Inventario_CurCarazo[Categoria Obsolescencia] ) ), 0 ) * 100, "0.0" )
			
			VAR Descripcion =
			    SWITCH(
			        Cat,
			        "Obsoleto",   "Equipos con procesador Gen 3 o anterior. Rendimiento limitado, sin soporte de actualizaciones de seguridad. Se recomienda reemplazo inmediato.",
			        "Vigilancia", "Equipos con procesador Gen 5 a Gen 9. Funcionan correctamente pero se acercan al fin de su vida útil. Planificar reemplazo a mediano plazo.",
			        "Vigente",    "Equipos con procesador Gen 10 o superior. Rendimiento óptimo y soporte activo. No requieren acción inmediata.",
			        "Pendiente",  "Equipos cuya información de generación de procesador aún no ha sido registrada en el inventario.",
			        "Sin información"
			    )
			
			VAR ColorBorde =
			    SWITCH(
			        Cat,
			        "Obsoleto",   "#DC0A32",
			        "Vigilancia", "#F5BD46",
			        "Vigente",    "#2C5697",
			        "Pendiente",  "#9D9D9C",
			        "#153455"
			    )
			
			VAR ColorTexto =
			    SWITCH(
			        Cat,
			        "Obsoleto",   "#DC0A32",
			        "Vigilancia", "#B8860B",
			        "Vigente",    "#2C5697",
			        "Pendiente",  "#9D9D9C",
			        "#153455"
			    )
			
			VAR ColorFondoBarra =
			    SWITCH(
			        Cat,
			        "Obsoleto",   "#FDECEA",
			        "Vigilancia", "#FEF6E0",
			        "Vigente",    "#EAF0FB",
			        "Pendiente",  "#F5F5F5",
			        "#F0F0F0"
			    )
			
			VAR Icono =
			    SWITCH(
			        Cat,
			        "Obsoleto",   "",
			        "Vigilancia", "",
			        "Vigente",    "",
			        "Pendiente",  "",
			        "Generación de Procesadores de Desktop y Laptop"
			    )
			
			RETURN
			"<div style='
			    background:#FFFFFF;
			    border:2px solid " & ColorBorde & ";
			    border-radius:8px;
			    padding:12px 14px;
			    font-family:Trebuchet MS, sans-serif;
			    width:100%;
			    height:100%;
			    box-sizing:border-box;
			'>
			    <div style='
			        font-size:13px;
			        font-weight:700;
			        color:" & ColorTexto & ";
			        margin-bottom:8px;
			        display:flex;
			        align-items:center;
			        gap:6px;
			        border-bottom:1px solid #E0E0E0;
			        padding-bottom:8px;
			    '>" & Icono & " " & Cat & "</div>
			
			    <div style='
			        font-size:10px;
			        color:#9D9D9C;
			        font-weight:600;
			        margin-bottom:4px;
			        text-transform:uppercase;
			        letter-spacing:0.5px;
			    '>Total equipos</div>
			
			    <div style='
			        font-size:22px;
			        font-weight:700;
			        color:" & ColorTexto & ";
			        margin-bottom:4px;
			        line-height:1;
			    '>" & TotalCat & "
			        <span style='font-size:12px;color:#9D9D9C;font-weight:400;'>(" & PctCat & "%)</span>
			    </div>
			
			    <div style='
			        background:" & ColorFondoBarra & ";
			        border-radius:6px;
			        height:8px;
			        margin-bottom:12px;
			        overflow:hidden;
			    '>
			        <div style='
			            background:" & ColorBorde & ";
			            width:" & PctCat & "%;
			            height:8px;
			            border-radius:6px;
			        '></div>
			    </div>
			
			    <div style='
			        font-size:10px;
			        color:#153455;
			        line-height:1.5;
			    '>" & Descripcion & "</div>
			</div>"
		lineageTag: 75e2b2ca-5498-43d9-95f6-4fcd47104962

	measure HTML_Edificio_Card =
			
			VAR EdificioSeleccionado = SELECTEDVALUE('Edificios'[Ubicación_Maps], "Selecciona un edificio en el mapa")
			
			RETURN
			IF(
			    SELECTEDVALUE('Edificios'[Ubicación_Maps]) = BLANK(),
			    "<div style='
			        background:transparent;
			        border:1.5px solid #3B1F6E;
			        border-radius:8px;
			        padding:30px;
			        font-family:Segoe UI, sans-serif;
			        text-align:center;
			        box-sizing:border-box;
			        width:100%;
			        height:100%;
			    '>
			        <div style='
			            width:48px;
			            height:48px;
			            background:rgba(124,58,237,0.15);
			            border:1.5px solid #7C3AED;
			            border-radius:50%;
			            display:flex;
			            align-items:center;
			            justify-content:center;
			            margin:0 auto 14px;
			        '>
			            <svg xmlns=""http://www.w3.org/2000/svg"" width=""22"" height=""22"" viewBox=""0 0 24 24"" fill=""none"">
			                <path d=""M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"" stroke=""#A855F7"" stroke-width=""1.5"" fill=""none""/>
			                <circle cx=""12"" cy=""9"" r=""2.5"" stroke=""#A855F7"" stroke-width=""1.5"" fill=""none""/>
			            </svg>
			        </div>
			        <div style='font-size:11px;color:#FFFFFF;letter-spacing:0.3px;line-height:1.5;'>
			            Selecciona un edificio<br>en el mapa para ver el detalle
			        </div>
			    </div>",
			
			    "<div style='
			        background:transparent;
			        border:1.5px solid #7C3AED;
			        border-radius:8px;
			        padding:16px;
			        font-family:Segoe UI, sans-serif;
			        box-sizing:border-box;
			        width:100%;
			        height:100%;
			    '>
			        <div style='
			            background:linear-gradient(135deg,#1E1B4B,#2D2060);
			            border:1px solid #7C3AED;
			            border-radius:8px;
			            padding:14px 16px;
			            margin-bottom:14px;
			        '>
			            <div style='
			                font-size:9px;
			                color:#A78BFA;
			                letter-spacing:1.5px;
			                text-transform:uppercase;
			                font-weight:600;
			                margin-bottom:6px;
			            '>Edificio seleccionado</div>
			            <div style='
			                font-size:13px;
			                font-weight:700;
			                color:#E2E2F0;
			                line-height:1.4;
			            '>" & EdificioSeleccionado & "</div>
			        </div>
			
			        <div style='
			            display:flex;
			            align-items:center;
			            gap:8px;
			            padding:10px 12px;
			            background:rgba(168,85,247,0.08);
			            border:0.5px solid #3B1F6E;
			            border-radius:6px;
			            margin-bottom:10px;
			        '>
			            <svg xmlns=""http://www.w3.org/2000/svg"" width=""16"" height=""16"" viewBox=""0 0 24 24"" fill=""none"">
			                <path d=""M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"" stroke=""#A855F7"" stroke-width=""1.5"" fill=""none""/>
			                <circle cx=""12"" cy=""9"" r=""2.5"" stroke=""#A855F7"" stroke-width=""1.5"" fill=""none""/>
			            </svg>
			            <span style='font-size:10px;color:#C4B5FD;font-weight:500;'>Ubicación en mapa activa</span>
			            <div style='
			                margin-left:auto;
			                width:8px;
			                height:8px;
			                border-radius:50%;
			                background:#34D399;
			                box-shadow:0 0 4px #34D399;
			            '></div>
			        </div>
			    </div>"
			)
		lineageTag: 5a4aec31-a187-49e9-af2a-61a4aa69223d

