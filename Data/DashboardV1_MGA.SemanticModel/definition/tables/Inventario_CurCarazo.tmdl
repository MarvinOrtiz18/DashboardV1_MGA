	measure 'Total Modelos Distintos' =
			
			DISTINCTCOUNT( Inventario_CurCarazo[Modelo] )
		formatString: 0
		lineageTag: 868a13bd-3b01-4b57-8c9a-e1ae62504057

	measure 'Modelo Mas Frecuente' =
			
			CALCULATE(
			    SELECTEDVALUE( Inventario_CurCarazo[Modelo] ),
			    TOPN(
			        1,
			        SUMMARIZE(
			            FILTER(
			                Inventario_CurCarazo,
			                UPPER( TRIM( Inventario_CurCarazo[Modelo] ) ) <> "PENDIENTE"
			                    && NOT( ISBLANK( Inventario_CurCarazo[Modelo] ) )
			            ),
			            Inventario_CurCarazo[Modelo],
			            "n", COUNTROWS( Inventario_CurCarazo )
			        ),
			        [n], DESC
			    )
			)
		lineageTag: e3eeeab1-5c17-4e48-9274-f623e1cc4838

	measure 'Equipos por Modelo' =
			
			CALCULATE( [Total Equipos] )
		formatString: 0
		lineageTag: fd1f6397-090b-4d8e-81b1-00c059bca9bd

	measure 'Series Duplicadas' =
			
			COUNTROWS(
			    FILTER(
			        SUMMARIZE(
			            FILTER(
			                Inventario_CurCarazo,
			                NOT( ISBLANK( Inventario_CurCarazo[Serie] ) )
			                    && UPPER( TRIM( Inventario_CurCarazo[Serie] ) ) <> "PENDIENTE"
			            ),
			            Inventario_CurCarazo[Serie],
			            "Total", COUNTROWS( Inventario_CurCarazo )
			        ),
			        [Total] > 1
			    )
			)
		formatString: 0
		lineageTag: 7dcf84e7-4db2-426c-bf57-06d00bff230e

	measure 'Equipos Con Serie Duplicada' =
			
