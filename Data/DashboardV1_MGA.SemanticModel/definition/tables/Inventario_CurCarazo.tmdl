	column Serie
		dataType: string
		lineageTag: 4d8c317b-c3c3-4bec-9663-eb4c3a97c128
		summarizeBy: none
		sourceColumn: Serie

		annotation SummarizationSetBy = Automatic

	column 'Es Serie Duplicada' =
			
			VAR ValorActual = Inventario_CurCarazo[Serie]
			VAR Conteo =
			    CALCULATE(
			        COUNTROWS( Inventario_CurCarazo ),
			        ALL( Inventario_CurCarazo ),
			        Inventario_CurCarazo[Serie] = ValorActual
			    )
			RETURN
			IF(
			    Conteo > 1
			        && NOT( ISBLANK( ValorActual ) )
			        && UPPER( TRIM( ValorActual ) ) <> "PENDIENTE",
			    "Duplicado (" & Conteo & " veces)",
			    "OK"
			)
		lineageTag: 184d95ce-caa5-41a3-8f23-cf1bbebab4d4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

