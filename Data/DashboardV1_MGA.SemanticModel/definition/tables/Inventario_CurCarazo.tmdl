			)
		formatString: 0
		lineageTag: 17b37f17-261f-46a2-a925-4ca82f68997c

	measure 'Label Pct RAM' =
			
			VAR Total = [Total Equipos]
			VAR Pct = FORMAT( DIVIDE( Total, CALCULATE( [Total Equipos], ALL( Inventario_CurCarazo[RAM] ) ), 0 ) * 100, "0.0" )
			RETURN
			Total & "  (" & Pct & "%)"
		lineageTag: 68958985-0f15-46ec-b5d8-606b2c7166b5

	measure 'Label Pct SO' =
			
			VAR Total = [Total Equipos]
			VAR Pct = FORMAT( DIVIDE( Total, CALCULATE( [Total Equipos], ALL( Inventario_CurCarazo[Sistema Operativo] ) ), 0 ) * 100, "0.0" )
			RETURN
			Total & "  (" & Pct & "%)"
		lineageTag: 0123c743-daa0-4738-ae1b-2c35f0fe828b

	measure 'Pct Windows11' = DIVIDE( [SW Windows11], [Total Equipos], 0 )
		lineageTag: a9ef52b5-cb1f-4cf3-9c6d-01acba7cdea6

