	measure 'Header HTML' =
			
			"<div style='
			    background: linear-gradient(135deg, #153455 0%, #2C5697 100%);
			    border-bottom: 3px solid #F5BD46;
			    padding: 8px 20px;
			    display: flex;
			    align-items: center;
			    justify-content: space-between;
			    width: 100%;
			    height: 100%;
			    font-family: Trebuchet MS, sans-serif;
			    box-sizing: border-box;
			'>
			    <!-- LOGO + INSTITUCIÓN -->
			    <div style='display: flex; align-items: center; gap: 14px;'>
			        <div style='
			            width: 42px; height: 42px;
			            background: rgba(255,255,255,0.1);
			            border: 1.5px solid #F5BD46;
			            border-radius: 10px;
			            display: flex; align-items: center; justify-content: center;
			            flex-shrink: 0;
			        '>
			            <svg xmlns=""http://www.w3.org/2000/svg"" width=""24"" height=""24"" viewBox=""0 0 24 24"" fill=""none"">
			                <rect x=""2"" y=""3"" width=""20"" height=""13"" rx=""2"" stroke=""#F5BD46"" stroke-width=""1.5"" fill=""none""/>
			                <path d=""M8 21h8M12 17v4"" stroke=""#F5BD46"" stroke-width=""1.5"" stroke-linecap=""round""/>
			                <circle cx=""8"" cy=""9"" r=""1.2"" fill=""#FFFFFF""/>
			                <circle cx=""12"" cy=""9"" r=""1.2"" fill=""#F5BD46""/>
			                <circle cx=""16"" cy=""9"" r=""1.2"" fill=""#FFFFFF""/>
			                <path d=""M8 9h1.8M13.2 9H14.8"" stroke=""rgba(255,255,255,0.4)"" stroke-width=""1"" stroke-linecap=""round""/>
			                <path d=""M9.5 12.5a3.5 3.5 0 015 0"" stroke=""#FFFFFF"" stroke-width=""1.2"" stroke-linecap=""round"" fill=""none""/>
			                <path d=""M11 13.8a1.5 1.5 0 012 0"" stroke=""#FFFFFF"" stroke-width=""1.2"" stroke-linecap=""round"" fill=""none""/>
			            </svg>
			        </div>
			        <div>
			            <div style='
			                font-size: 14px;
			                font-weight: 700;
			                color: #FFFFFF;
			                letter-spacing: 0.3px;
			                line-height: 1.3;
			            '>Universidad Nacional Autónoma de Nicaragua, Managua</div>
			            <div style='
			                font-size: 14px;
			                color: #F5BD46;
			                font-weight: 600;
			                letter-spacing: 0.5px;
			            '>UNAN-Managua &nbsp;·&nbsp; CUR-Carazo</div>
			        </div>
			    </div>
			
			    <!-- CENTRO -->
			    <div style='text-align: center;'>
			        <div style='
			            font-size: 16px;
			            font-weight: 700;
			            color: #F5BD46;
			            letter-spacing: 1px;
			            text-transform: uppercase;
			        '>Reporte de Inventario Tecnológico</div>
			        <div style='
			            font-size: 16px;
			            color: rgba(255,255,255,0.6);
			            margin-top: 2px;
			            letter-spacing: 0.5px;
			        '>Dashboard de gestión de activos tecnológicos institucionales</div>
			    </div>
			
			    <!-- FECHA + ESTADO -->
			    <div style='text-align: right;'>
			        <div style='
			            font-size: 14px;
			            color: rgba(255,255,255,0.6);
			            font-weight: 600;
			            margin-bottom: 4px;
			            letter-spacing: 0.5px;
			        '>Fecha actual</div>
			        <div style='
			            font-size: 16px;
			            color: #FFFFFF;
			            font-weight: 700;
			        '>" & FORMAT(TODAY(), "DD/MM/YYYY") & "</div>
			        <div style='
			            display: inline-block;
			            margin-top: 4px;
			            background: rgba(44,86,151,0.4);
			            border: 1px solid #FFFFFF;
			            border-radius: 20px;
			            padding: 2px 10px;
			            font-size: 12px;
			            color: #FFFFFF;
			            font-weight: 600;
			        '>● EN LÍNEA</div>
			    </div>
			</div>"
		lineageTag: eb6d5a65-a670-4be1-bf8f-784063cdd99c

	measure 'Footer HTML' =
			
			"<div style='
			    background:linear-gradient(135deg,#13131F 0%,#1E1B4B 100%);
			    border-top:2px solid #7C3AED;
			    padding:6px 20px;
			    display:flex;
			    align-items:center;
			    justify-content:center;
			    width:100%;
			    height:100%;
			    font-family:Segoe UI,sans-serif;
			    box-sizing:border-box;
			'>
			    <span style='
			        font-size:9px;
			        color:#6D6D8A;
			        letter-spacing:0.5px;
			    '>© " & FORMAT(TODAY(), "YYYY") & " &nbsp;·&nbsp; Todos los derechos reservados &nbsp;·&nbsp; Desarrollado por <span style=""color:#A78BFA;font-weight:600;"">Área de TI — CUR-Carazo</span></span>
			</div>"
		lineageTag: a417b2e2-2f12-45a9-9de9-ecda287acf32

